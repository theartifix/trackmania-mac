     set_app_icon();
 }

+/* GetWindowRect(desktop) returns the primary monitor, not the virtual desktop.
+ * Use the server's cached rectangle, which SetDesktopWindow initializes to the
+ * complete desktop, so unchanged multi-monitor layouts do not trigger broadcasts. */
+static BOOL get_virtual_desktop_rect(HWND hwnd, RECT *rect)
+{
+    BOOL ret;
+
+    SERVER_START_REQ(get_window_rectangles)
+    {
+        req->handle = wine_server_user_handle(hwnd);
+        req->relative = COORDS_SCREEN;
+        req->dpi = 0;
+        if ((ret = !wine_server_call(req)))
+        {
+            rect->left = reply->window.left;
+            rect->top = reply->window.top;
+            rect->right = reply->window.right;
+            rect->bottom = reply->window.bottom;
+        }
+    }
+    SERVER_END_REQ;
+    return ret;
+}
+
